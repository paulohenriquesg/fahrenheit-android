<resources>

    <style name="Theme.Fahrenheit" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">#FF121212</item>
    </style>

    <!-- The launcher entry's window until its first frame (#191): the icon on
         the app's background, rather than the background alone. -->
    <style name="Theme.Fahrenheit.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#FF121212</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.Fahrenheit</item>
    </style>
</resources>