<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing leaves the device. The app's only stored data is the server address
  and the tokens for it, and those belong to the person's own server rather
  than in a cloud backup. The encrypted preferences could not survive a restore
  anyway: their key lives in this device's keystore and is not backed up, so a
  restored copy is ciphertext nothing can read.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
